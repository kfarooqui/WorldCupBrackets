# ── Supabase ──────────────────────────────────────────────────────────────
# From your Supabase project: Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Server-only. NEVER expose to the browser. Used by admin actions + seed script.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── SMTP (notification emails: approvals + match digests) ─────────────────
# Sent from your app code via Gmail SMTP (same account as Supabase auth emails).
# SMTP_USER is your Gmail address; SMTP_PASS is a Gmail App Password
# (Google Account → Security → 2-Step Verification → App passwords), NOT your
# normal password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=kfarooqui@gmail.com
SMTP_PASS=your-16-char-app-password
# Display name + from address shown to recipients.
EMAIL_FROM="World Cup Pool <kfarooqui@gmail.com>"

# ── App ─────────────────────────────────────────────────────────────────────
# Public site URL — used for magic-link auth redirects. Keep this as localhost
# in local dev so sign-in links come back to your machine.
# Local: http://localhost:3000   Prod: https://your-app.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Canonical URL for links INSIDE emails (digest, approval). Always set this to
# the PRODUCTION url — even in .env.local — so a digest accidentally sent from a
# local dev server still links recipients to the live site, not localhost.
EMAIL_SITE_URL=https://your-app.vercel.app

# Email of the account that should be the admin (you).
ADMIN_EMAIL=kfarooqui@gmail.com

# Secret protecting the cron digest endpoint (any long random string).
CRON_SECRET=change-me-to-a-long-random-string
