# ── Supabase ──────────────────────────────────────────────────────────────
# From your Supabase project: Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Server-only. NEVER expose to the browser. Used by admin actions + seed script.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Resend (notification emails) ──────────────────────────────────────────
# From resend.com → API Keys
RESEND_API_KEY=re_your_api_key
# Verified sender. For testing you may use: onboarding@resend.dev
EMAIL_FROM="World Cup Pool <onboarding@resend.dev>"

# ── App ─────────────────────────────────────────────────────────────────────
# Public site URL (used in magic-link redirects + email links).
# Local: http://localhost:3000   Prod: https://your-app.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Email of the account that should be the admin (you).
ADMIN_EMAIL=kfarooqui@gmail.com

# Secret protecting the cron digest endpoint (any long random string).
CRON_SECRET=change-me-to-a-long-random-string
